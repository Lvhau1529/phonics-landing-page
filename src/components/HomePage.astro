---
/**
 * Trang chủ cho một ngôn ngữ. Không có JS phía client: mọi thứ render sẵn ở build (SSG), FAQ dùng
 * <details>. Thứ tự heading: 1 H1 (hero) → H2 mỗi section → H3 từng thẻ.
 */
import { getImage, Image } from 'astro:assets';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import logo from '@/assets/logo.png';
import { CONTENT, GAMES, LOCALE_META, type Locale } from '@/i18n/content';
import Base from '@/layouts/Base.astro';
import { absolute, buildJsonLd, gameLink } from '@/lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = CONTENT[locale];
const site = Astro.site;

const coverSrc = Object.fromEntries(
  await Promise.all(
    GAMES.map(async (g) => [
      g.id,
      absolute(site, (await getImage({ src: g.cover, width: 480, format: 'webp' })).src),
    ]),
  ),
);
const logoSrc = absolute(site, (await getImage({ src: logo, width: 512, format: 'webp' })).src);
const jsonLd = buildJsonLd(site, locale, logoSrc, coverSrc);

// Hero: bìa Food Stream ở giữa (ảnh LCP → eager + fetchpriority high), hai game còn lại hai bên.
const heroOrder = ['bread-catcher', 'food-stream', 'phonics-ocean'] as const;
const heroGames = heroOrder.map((id) => GAMES.find((g) => g.id === id)!);
const coverSizes = '(max-width: 640px) 90vw, (max-width: 1100px) 45vw, 480px';
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  path={LOCALE_META[locale].path}
  ogAlt={c.meta.ogAlt}
  jsonLd={jsonLd}
>
  <Header locale={locale} />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{c.hero.eyebrow}</p>
          <h1 id="hero-title">{c.hero.title}</h1>
          <p class="lead">{c.hero.lead}</p>
          <div class="hero-cta">
            <a class="btn btn-primary" href={gameLink()}>
              {c.hero.primary}
            </a>
            <a class="btn btn-ghost" href="#games">
              {c.hero.secondary}
            </a>
          </div>
          <ul class="checks">
            {c.hero.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
        <div class="hero-art">
          {heroGames.map((game, i) => (
            <Image
              class:list={['hero-cover', `hero-cover-${i}`]}
              src={game.cover}
              alt={i === 1 ? c.hero.imageAlt : ''}
              widths={[320, 480]}
              sizes={coverSizes}
              format="webp"
              loading="eager"
              fetchpriority={i === 1 ? 'high' : 'auto'}
            />
          ))}
        </div>
      </div>
    </section>

    <section id="games" class="section" aria-labelledby="games-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="games-title">{c.games.title}</h2>
          <p>{c.games.lead}</p>
        </div>
        <ul class="games">
          {GAMES.map((game) => {
            const copy = c.games.items[game.id];
            return (
              <li class="game" style={`--accent: ${game.accent}`}>
                <article aria-labelledby={`game-${game.id}`}>
                  <Image
                    src={game.cover}
                    alt={copy.coverAlt}
                    widths={[320, 480]}
                    sizes="(max-width: 760px) 90vw, (max-width: 1100px) 45vw, 360px"
                    format="webp"
                    loading="lazy"
                  />
                  <div class="game-body">
                    <h3 id={`game-${game.id}`}>{game.name}</h3>
                    <p class="tagline">{copy.tagline}</p>
                    <p>{copy.description}</p>
                    <ul class="chips" aria-label={c.nav.skills}>
                      {copy.skills.map((skill) => (
                        <li>{skill}</li>
                      ))}
                    </ul>
                    <p class="modes">
                      <strong>{c.games.modesLabel}:</strong> {copy.modes}
                    </p>
                    <a class="btn btn-primary game-cta" href={gameLink(game.id)}>
                      {copy.cta}
                    </a>
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section id="skills" class="section skills" aria-labelledby="skills-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="skills-title">{c.skills.title}</h2>
          <p>{c.skills.lead}</p>
        </div>
        <ol class="skill-list">
          {c.skills.items.map((skill) => (
            <li>
              <h3>{skill.name}</h3>
              <p class="example" lang="en">
                {skill.example}
              </p>
              <p>{skill.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="features-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="features-title">{c.features.title}</h2>
          <p>{c.features.lead}</p>
        </div>
        <ul class="features">
          {c.features.items.map((item) => (
            <li>
              <span class="icon" aria-hidden="true">
                {item.icon}
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="classroom" class="section steps-section" aria-labelledby="steps-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="steps-title">{c.steps.title}</h2>
          <p>{c.steps.lead}</p>
        </div>
        <ol class="steps">
          {c.steps.items.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="faq" class="section" aria-labelledby="faq-title">
      <div class="wrap faq-wrap">
        <div class="section-head">
          <h2 id="faq-title">{c.faq.title}</h2>
        </div>
        <div class="faq">
          {c.faq.items.map((item, i) => (
            <details open={i === 0}>
              <summary>
                <h3>{item.q}</h3>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <div class="wrap cta-box">
        <h2 id="cta-title">{c.cta.title}</h2>
        <p>{c.cta.text}</p>
        <a class="btn btn-primary" href={gameLink()}>
          {c.cta.button}
        </a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 96px) clamp(56px, 8vw, 112px);
    background:
      radial-gradient(circle at 85% 15%, rgb(255 210 63 / 0.35), transparent 40%),
      radial-gradient(circle at 10% 90%, rgb(32 184 166 / 0.18), transparent 45%),
      linear-gradient(160deg, #fdf6ff 0%, var(--c-bg) 60%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }

  .eyebrow {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.9375rem;
    color: var(--c-brand-dark);
    background: var(--c-brand-soft);
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(2.125rem, 1.3rem + 3.6vw, 3.75rem);
    color: var(--c-brand-dark);
  }

  .lead {
    margin-top: 18px;
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    color: var(--c-muted);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--c-muted);
  }

  .checks li::before {
    content: '✓';
    margin-right: 6px;
    color: var(--c-teal);
    font-weight: 800;
  }

  .hero-art {
    position: relative;
    aspect-ratio: 16 / 12;
  }

  .hero-cover {
    position: absolute;
    width: 72%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 5px solid #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .hero-cover-0 {
    top: 0;
    left: 0;
    transform: rotate(-6deg);
  }

  .hero-cover-2 {
    bottom: 0;
    right: 0;
    transform: rotate(5deg);
  }

  .hero-cover-1 {
    z-index: 1;
    top: 50%;
    left: 50%;
    width: 80%;
    transform: translate(-50%, -50%) rotate(-1deg);
    box-shadow: 0 24px 50px -18px rgb(74 32 128 / 0.5);
  }

  /* ---------- Games ---------- */
  .games {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game article {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-surface);
    box-shadow: var(--shadow);
    border-top: 6px solid var(--accent);
  }

  .game img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .game-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 22px 24px 26px;
  }

  .game h3 {
    font-size: 1.625rem;
    color: var(--c-brand-dark);
  }

  .tagline {
    font-weight: 700;
    color: var(--c-ink);
  }

  .game-body > p:not(.tagline) {
    color: var(--c-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 2px 12px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--c-ink);
    background: color-mix(in srgb, var(--accent) 22%, white);
  }

  .modes {
    font-size: 0.9375rem;
  }

  .game-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  /* ---------- Skills ---------- */
  .skills {
    background: var(--c-brand-soft);
  }

  .skill-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: skill;
  }

  .skill-list li {
    position: relative;
    padding: 24px 22px 22px;
    border-radius: var(--radius);
    background: var(--c-surface);
    counter-increment: skill;
  }

  .skill-list li::before {
    content: counter(skill);
    position: absolute;
    top: 18px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-weight: 800;
    font-size: 0.875rem;
    color: var(--c-brand-dark);
    background: var(--c-brand-soft);
  }

  .skill-list h3 {
    padding-right: 36px;
    font-size: 1.25rem;
  }

  .example {
    margin-block: 6px;
    font-weight: 800;
    font-size: 1.125rem;
    color: var(--c-brand);
  }

  .skill-list p:last-child {
    color: var(--c-muted);
    font-size: 0.9375rem;
  }

  /* ---------- Features ---------- */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    padding: 28px;
    border-radius: var(--radius);
    background: var(--c-surface);
    box-shadow: inset 0 0 0 2px var(--c-line);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 16px;
    border-radius: 16px;
    font-size: 1.75rem;
    background: #fff4d1;
  }

  .features h3 {
    font-size: 1.25rem;
  }

  .features p {
    margin-top: 8px;
    color: var(--c-muted);
  }

  /* ---------- Steps ---------- */
  .steps-section {
    background: linear-gradient(180deg, var(--c-bg), #fff4e0);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    padding: 28px;
    border-radius: var(--radius);
    background: var(--c-surface);
    box-shadow: var(--shadow);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 14px;
    border-radius: 50%;
    font-weight: 800;
    font-size: 1.375rem;
    color: #fff;
    background: var(--c-brand);
    box-shadow: 0 4px 0 0 var(--c-brand-dark);
  }

  .steps h3 {
    font-size: 1.25rem;
  }

  .steps p {
    margin-top: 8px;
    color: var(--c-muted);
  }

  /* ---------- FAQ ---------- */
  .faq-wrap {
    max-width: 860px;
  }

  .faq {
    display: grid;
    gap: 14px;
  }

  details {
    border-radius: 16px;
    background: var(--c-surface);
    box-shadow: inset 0 0 0 2px var(--c-line);
  }

  details[open] {
    box-shadow: inset 0 0 0 2px var(--c-brand);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--c-brand-dark);
    background: var(--c-brand-soft);
  }

  details[open] summary::after {
    content: '−';
  }

  summary h3 {
    font-size: 1.125rem;
  }

  details p {
    padding: 0 22px 20px;
    color: var(--c-muted);
  }

  /* ---------- CTA ---------- */
  .cta {
    padding-block: 0 clamp(56px, 9vw, 104px);
  }

  .cta-box {
    padding-block: clamp(40px, 6vw, 72px);
    border-radius: 32px;
    text-align: center;
    color: #fff;
    background:
      radial-gradient(circle at 90% 10%, rgb(255 210 63 / 0.35), transparent 35%),
      linear-gradient(135deg, var(--c-brand) 0%, var(--c-brand-dark) 100%);
  }

  .cta-box h2 {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
  }

  .cta-box p {
    margin: 12px auto 28px;
    max-width: 52ch;
    font-size: 1.125rem;
    color: #efe4fb;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .games {
      grid-template-columns: repeat(2, 1fr);
    }
    /* 3 game / 2 cột: thẻ cuối trải ngang hai cột, ảnh bên trái */
    .game:last-child {
      grid-column: 1 / -1;
    }
    .game:last-child article {
      flex-direction: row;
    }
    .game:last-child img {
      flex: none;
      align-self: center;
      width: 46%;
      margin-left: 24px;
      border-radius: 14px;
    }
    .skill-list {
      grid-template-columns: repeat(2, 1fr);
    }
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      max-width: 560px;
      width: 100%;
      margin-inline: auto;
    }
    .steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .games,
    .skill-list,
    .features {
      grid-template-columns: 1fr;
    }
    .game:last-child article {
      flex-direction: column;
    }
    .game:last-child img {
      width: 100%;
      margin-left: 0;
      border-radius: 0;
    }
    .hero-cta .btn {
      width: 100%;
    }
    .cta-box {
      border-radius: 24px;
    }
  }
</style>
